# Required
SKARB_SESSION_SECRET=replace-with-at-least-32-random-characters
SKARB_ADMIN_USERNAME=admin
SKARB_ADMIN_PASSWORD=replace-with-a-strong-password

# Network
SKARB_HTTP_ADDR=:8080
# Use https://... and SKARB_COOKIE_SECURE=true when running behind TLS.
SKARB_PUBLIC_BASE_URL=http://127.0.0.1:8080
SKARB_COOKIE_SECURE=false
# Set only when behind a reverse proxy you control:
# SKARB_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Telegram (optional; web and MCP still work without it)
SKARB_TELEGRAM_BOT_TOKEN=
SKARB_TELEGRAM_POLL_TIMEOUT=30s
# Full MCP tool mode in DMs and on @mention/reply. Set false for legacy-only.
SKARB_TELEGRAM_TOOL_MODE=true

# LLM (optional; deterministic parser fallback works without it)
SKARB_LLM_API_KEY=

# Data and FX
SKARB_DATA_DIR=/data
SKARB_TZ=Europe/Kyiv
SKARB_FX_BACKFILL_DAYS=730
SKARB_MAX_ACTIVE_USERS=2
SKARB_LOG_LEVEL=info
